---
import Layout from "../layouts/Layout.astro";
import ProjectSnippet from "../components/ProjectSnippet.astro";
import { Image } from "astro:assets";
import me from "../assets/me-cartoon-2.png";
---

<Layout>
  <main
    class="container min-h-screen h-screen overflow-hidden grid grid-cols-[1fr_2fr] mx-auto gap-36"
  >
    <div class="mt-32 sticky top-32">
      <Image
        src={me}
        alt="A picture of Paul-Henry Ngounou"
        class="max-w-36 mb-5"
        transition:name="cartoon"
      />

      <h1 class="font-serif text-5xl font-bold mb-5" transition:name="title">
        My projects.
      </h1>

      <p>
        Here are some of the projects I've worked on. I'm always excited to take
        on new challenges and collaborate on innovative ideas. Feel free to
        explore and reach out if you'd like to connect!
      </p>

      <button class="accent mt-9 text-lg"
        ><i class="fa-brands fa-github mr-2"></i>Checkout my Github</button
      >
    </div>

    <div class="flex flex-col gap-28 mt-10 overflow-y-auto py-10 no-scrollbar">
      <ProjectSnippet
        title="Project One"
        description="A brief description of Project One. This project involves building a responsive web application using modern web technologies."
      />

