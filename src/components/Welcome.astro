---
import { Image } from "astro:assets";
import me from "../assets/me-cartoon-2.png";
---

<main class="min-h-screen grid place-items-center overflow-hidden px-[10%]">
  <div class="max-w-7xl flex justify-between">
    <div class="max-w-3xl">
      <Image
        src={me}
        alt="A picture of Paul-Henry Ngounou"
        class="max-w-40 mb-5 md:hidden"
      />

      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-balance mb-3 font-serif"
        transition:name="title"
      >
        I build sleek software products.
      </h1>

      <span class="text-neutral-400 font-accent text-lg tracking-widest"
        >PAUL-HENRY NGOUNOU — SOFTWARE ENGINEER</span
      >

      <p class="text-neutral-200 mt-10 text-balance">
        I write code, break things, fix them, and make ideas come alive. Always
        learning, always building — whether it’s crafting <span class="accent"
          >sleek frontends</span
        >, engineering <span class="accent">reliable backends</span>, or
        experimenting with new technologies.
      </p>

      <ul class="mt-6">
        <li class="mb-2">
          Based in <span class="accent">Paris, France</span> — I speak <span
            class="accent">English & French</span
          >.
        </li>

        <li>
          <span class="mr-2">&rightarrow;</span>
          Checkout <a href="https://github.com/Paul-HenryN" class="accent"
            ><i class="fa-brands fa-github"></i> my work</a
          >
        </li>

        <li>
          <span class="mr-2">&rightarrow;</span>
          Connect with me on <a
            href="https://www.linkedin.com/in/paul-henry-ngounou-592194285/"
            class="accent"><i class="fa-brands fa-linkedin"></i> LinkedIn</a
          >
        </li>
      </ul>
    </div>

    <div class="flex-col justify-between items-end hidden md:flex">
      <Image
        src={me}
        alt="A picture of Paul-Henry Ngounou"
        class="max-w-80 hover:scale-105 transition-transform duration-300 hover:-rotate-6"
        transition:name="cartoon"
      />

      <div class="whitespace-nowrap">
        I also <a
          href="https://www.instagram.com/paul.__.henry/"
          class="accent"
          target="_blank"
          ><i class="fa-brands fa-instagram"></i> draw and paint</a
        >
      </div>
    </div>
  </div>
</main>
