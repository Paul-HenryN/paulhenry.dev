---
import { Image } from "astro:assets";
import me from "../assets/me.jpg";
---

<main class="hero min-h-screen grid place-items-center overflow-hidden">
  <div class="max-w-7xl flex justify-between">
    <div class="max-w-3xl">
      <h1 class="text-6xl font-bold text-balance mb-3 font-serif">
        I build sleek software products.
      </h1>

      <span class="text-neutral-400 font-accent text-lg tracking-widest"
        >PAUL-HENRY NGOUNOU — SOFTWARE ENGINEER</span
      >

      <p class="text-neutral-200 mt-10 text-balance">
        I write code, break things, fix them, and make ideas come alive on the
        web. Always learning, always building — whether it’s crafting <span
          class="accent">sleek frontends</span
        >, engineering <span class="accent">reliable backends</span>, or
        experimenting with new technologies.
      </p>

      <ul class="mt-6">
        <li class="mb-2">
          Based in <span class="accent">Paris, France</span> — I speak <span
            class="accent">English & French</span
          >.
        </li>

        <li>
          <span class="mr-2">&rightarrow;</span>
          Checkout <a href="/about" class="accent"
            ><i class="fa-brands fa-github"></i> my work</a
          >
        </li>

        <li>
          <span class="mr-2">&rightarrow;</span>
          Connect with me on <a href="/about" class="accent"
            ><i class="fa-brands fa-linkedin"></i> LinkedIn</a
          >
        </li>
      </ul>
    </div>

    <div class="flex flex-col justify-between items-end">
      <Image
        src={me}
        alt="A picture of Paul-Henry Ngounou"
        class="max-w-40 rounded-full"
      />

      <div>
        I also <a
          href="https://www.instagram.com/paul.__.henry/"
          class="accent"
          target="_blank"
          ><i class="fa-brands fa-instagram"></i> draw and paint</a
        >
      </div>
    </div>
  </div>
</main>

<style>
  .hero {
    --_color-grid: rgba(255, 255, 255, 0.151);

    position: relative;

    &::after {
      content: "";
      position: absolute;
      inset: 0;

      z-index: -10;

      background: linear-gradient(
          to top right,
          transparent 20%,
          var(--color-bg) 35% 65%,
          transparent
        ),
        repeating-linear-gradient(
          to bottom,
          var(--_color-grid) 0 1px,
          transparent 1px 50px
        ),
        repeating-linear-gradient(
          to right,
          var(--_color-grid) 0 1px,
          transparent 1px 50px
        );
    }
  }
</style>
