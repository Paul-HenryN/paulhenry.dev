---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>paulhenry.dev</title>
    <script
      is:inline
      src="https://kit.fontawesome.com/e61dda8ae2.js"
      crossorigin="anonymous"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=DM+Serif+Display:ital@0;1&family=Handjet:wght@100..900&family=Tiny5&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="relative">
    <slot />

    <Nav />
  </body>
</html>

<style>
  body {
    --_color-grid: rgba(255, 255, 255, 0.151);

    position: relative;

    &::after {
      content: "";
      position: absolute;
      inset: 0;

      z-index: -10;

      background: linear-gradient(
          to top right,
          transparent 20%,
          var(--color-bg) 35% 65%,
          transparent
        ),
        repeating-linear-gradient(
          to bottom,
          var(--_color-grid) 0 1px,
          transparent 1px 50px
        ),
        repeating-linear-gradient(
          to right,
          var(--_color-grid) 0 1px,
          transparent 1px 50px
        );
    }
  }
</style>
